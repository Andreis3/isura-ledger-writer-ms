{
  "application_name": "isura-ledger-ms",
  "env": "xxxx",
  "servers" :{
    "grpc": {
      "port": "xxx"
    },
    "http": {
      "port": "xxx"
    }
  },
  "nats": {
    "url": "nats://localhost:4222",
    "name": "LEDGER_EVENTS",
    "subject": "ledger.writer.event",
    "consumer": {
      "stream": "LEDGER_EVENTS",
      "name": "isura-ledger-writer-event",
      "durable": "isura-ledger-writer-event",
      "ask_wait_seconds": 30,
      "max_deliver": 5,
      "max_workers": 100,
      "max_message_size": 100
    }
  },
  "data_base": {
    "postgres": {
      "host": "localhost",
      "port": 5432,
      "user": "xxxx",
      "password": "xxxx",
      "database": "isura-ledger",
      "ssl_mode": "disable",
      "max_connections": 10,
      "min_connections": 1,
      "max_conn_lifetime": "5m",
      "max_conn_idle_time": "1m"
    }
  },
  "open_telemetry": {
    "host": "localhost:4318"
  },
  "version": "1.0.0"
}